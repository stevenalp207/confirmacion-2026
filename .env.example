# Sincronizacion del calendario desde Google Docs (sin Google Sheets)
# Opcion 1: pega aqui el link del doc compartido (o del export txt)
VITE_CALENDARIO_DOC_URL=

# Opcion 2: pega solo el ID del documento
VITE_CALENDARIO_DOC_ID=

# Formato recomendado dentro del Google Doc (una linea por evento):
# YYYY-MM-DD | Titulo | Descripcion | Tipo | Categoria | Prioridad
# Ejemplo:
# 2026-03-10 | Catequesis #4 | Tema principal | catequesis | Formacion | alta
